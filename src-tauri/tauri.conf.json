{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cobweb",
  "version": "0.1.0",
  "identifier": "com.cobweb.automation",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cobweb",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
  "active": true,
  "icon": ["icons/icon.ico"],
  "targets": ["nsis", "msi"]
  }
}
