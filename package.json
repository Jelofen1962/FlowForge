{
  "name": "flowforge-automation",
  "version": "0.3.29",
  "private": true,
  "description": "Windows desktop GUI for Selenium browser automation",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:win": "npm run build && electron-builder --win nsis --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "test:engine": "vitest run tests/runner.test.ts",
    "test:control-flow": "vitest run tests/controlFlow.test.ts",
    "verify:release": "node scripts/verify-release.cjs",
    "sync:release-version": "node scripts/sync-release-version.cjs",
    "mcp": "node mcp-server.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "selenium-webdriver": "^4.27.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.flowforge.desktop",
    "productName": "FlowForge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "engine/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!**/tests/**",
      "!**/.github/**",
      "mcp-server.mjs",
      "electron/ai-api.cjs",
      "electron/ai-provider.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "FlowForge-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asar": true,
    "compression": "maximum",
    "artifactName": "FlowForge-${version}-${arch}-Setup.${ext}",
    "asarUnpack": [
      "node_modules/selenium-webdriver/bin/**"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Amirreza Taati (Jelofen1962)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jelofen1962/FlowForge.git"
  }
}
